# ---------------------------------------------------------------------------
# Apparat Blueprint - backend environment
#
# Copy to `.env` (`mise run be:setup` does this for you). Every value below is a
# DUMMY/local-development default. Nothing in this file is a real secret.
#
# Loading order (later wins):
#   config/config.yaml -> config/config.local.yaml -> .env -> env vars -> CLI flags
#
# Viper maps nested keys with "." -> "_", so `app.log_level` becomes APP_LOG_LEVEL.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_CORS_ALLOW_ORIGINS=http://localhost:3400
APP_DB_FILENAME=apparat-blueprint
APP_ENV=development
APP_FRONTEND_URL=http://localhost:3400/
APP_GIN_MODE=debug
APP_LOG_FORMAT=json
APP_LOG_LEVEL=debug
APP_PORT=8080

# --- Observability ----------------------------------------------------------
APP_OTEL_ENDPOINT=localhost:3417
# Leave empty to disable Sentry. A real DSN looks like
# https://<key>@o0.ingest.sentry.io/<project>
SENTRY_DSN=
SENTRY_REPLAY_ERROR_SAMPLE_RATE=0.1
SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
SENTRY_TRACE_SAMPLE_RATE=0.1

# --- Datastores -------------------------------------------------------------
APP_REDIS_URL=redis://localhost:3451/0

# --- Object storage (S3 / MinIO) -------------------------------------------
# Defaults match the MinIO container in docker-compose.yaml.
# AWS_ACCESS_KEY_ID=local-admin
# AWS_SECRET_ACCESS_KEY=local-super-secret
# AWS_S3_BUCKET=apparat-blueprint
# AWS_S3_ENDPOINT=http://localhost:3450

# --- Transactional email (AWS SES v2) ---------------------------------------
# AWS_SES_REGION=eu-central-1
# AWS_SES_FROM_ADDRESS=no-reply@example.com

# --- OIDC / single sign-on --------------------------------------------------
# Leave commented out to run the admin UI unauthenticated. Uncommenting this
# enables the OIDC login flow (see doc/auth.md). The defaults point at the Dex
# container from docker-compose.yaml (admin@example.com / password).
# AUTH_TYPE=oidc
# AUTH_NAME=Dex
# AUTH_AUTHORITY=https://dex.apparat-blueprint.test/dex
# AUTH_CLIENT_ID=react-admin-client
# AUTH_SKIP_TLS_VERIFY=false

# --- Formatting -------------------------------------------------------------
# Must match ^[a-zA-Z]{2}-[A-Z]{2}$
# FORMAT_DATE_LOCALE=da-DK
