# ---------------------------------------------------------------------------
# Apparat Blueprint - frontend environment
#
# The committed `.env`, `.env.development` and `.env.production` files hold the
# working defaults for this template. This file documents every knob and shows
# which values to fill in for your own project.
#
# Vite only exposes variables prefixed with `VITE_` to the client bundle.
# NEVER put a real secret in a VITE_* variable - it is shipped to the browser.
#
# Note: the frontend reads its runtime configuration from the backend endpoint
# `GET /api/config`, validated with Zod (see src/core/config/config.schemas.ts).
# The variables below only control how that request is addressed and how the
# Sentry browser SDK is initialised.
# ---------------------------------------------------------------------------

# Base origin used to fetch `/api/config`.
# Leave EMPTY on purpose: the request then stays relative and is proxied to the
# backend by Traefik (and by the Vite dev proxy during `mise run fe:dev`).
# Set it to an absolute URL only if the API lives on a different origin.
VITE_API_HOST=

# Browser Sentry DSN. Leave empty to disable error reporting.
# A real DSN looks like https://<key>@o0.ingest.sentry.io/<project>
VITE_SENTRY_DSN=
VITE_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_TRACE_SAMPLE_RATE=1.0
